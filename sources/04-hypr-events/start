#!/usr/bin/env python3
"""Watch Hyprland window events; alert when a Teams window title matches."""
import json, os, re, socket, subprocess, sys
sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "..", "alert"))
import due

due.load_env()
CLASS = os.environ.get("HYPR_CLASS", "teams-for-linux")
PATTERN = re.compile(os.environ.get("HYPR_TITLE_PATTERN", r"(?i)meeting (has )?start|is starting|join now"))
run = os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")
sig = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE") or sorted(os.listdir(f"{run}/hypr"), key=lambda d: os.path.getmtime(f"{run}/hypr/{d}"))[-1]
os.environ["HYPRLAND_INSTANCE_SIGNATURE"] = sig


def class_of(addr):
    for c in json.loads(subprocess.check_output(["hyprctl", "clients", "-j"])):
        if c["address"].endswith(addr):
            return c["class"]
    return ""


def handle(klass, title):
    print(f"[{klass}] {title}", file=sys.stderr, flush=True)
    if klass == CLASS and PATTERN.search(title):
        due.alert("Teams", title)


s = socket.socket(socket.AF_UNIX)
s.connect(f"{run}/hypr/{sig}/.socket2.sock")
buf = b""
while chunk := s.recv(4096):
    buf += chunk
    *lines, buf = buf.split(b"\n")
    for line in lines:
        ev, _, data = line.decode(errors="replace").partition(">>")
        if ev == "openwindow":
            addr, _, klass, title = data.split(",", 3)
            handle(klass, title)
        elif ev == "windowtitlev2":
            addr, _, title = data.partition(",")
            handle(class_of(addr), title)
