#!/bin/bash
# Poll Microsoft Graph with the Azure CLI's token. Needs the tenant to let Azure CLI have Calendars.Read.
set -uo pipefail
ROOT=$(cd "$(dirname "$0")/../.." && pwd)
[[ -f $ROOT/config.env ]] && { set -a; . "$ROOT/config.env"; set +a; }

az account get-access-token --resource-type ms-graph >/dev/null 2>&1 ||
  az login --scope https://graph.microsoft.com/Calendars.Read || exit 1

while true; do
  s=$(date -u +%FT00:00:00Z) e=$(date -u -d tomorrow +%FT00:00:00Z)
  az rest --method get --headers 'Prefer=outlook.timezone="UTC"' \
    --url "https://graph.microsoft.com/v1.0/me/calendarView?startDateTime=$s&endDateTime=$e&\$top=50&\$select=id,subject,start,isCancelled,isAllDay,onlineMeeting,webLink" |
    python3 "$ROOT/alert/due.py" graph || echo "graph call failed (Unauthorized = tenant blocks Azure CLI for Calendars.Read; drop this option)" >&2
  sleep 60
done
