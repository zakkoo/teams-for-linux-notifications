#!/usr/bin/env python3
"""Eavesdrop on org.freedesktop.Notifications.Notify; alert when Teams/Firefox post a meeting-ish toast."""
import os, re, subprocess, sys
sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "..", "alert"))
import due

due.load_env()
APPS = {a.strip().lower() for a in os.environ.get("DBUS_APPS", "Microsoft Teams,teams-for-linux,Firefox").split(",")}
PATTERN = re.compile(os.environ.get("DBUS_PATTERN", r"(?i)\b(start(ed|ing|s)?|now|minutes?|reminder|join)\b"))
STR = re.compile(r'^\s+string "(.*)"$')

proc = subprocess.Popen(
    ["dbus-monitor", "--session", "interface='org.freedesktop.Notifications',member='Notify'"],
    stdout=subprocess.PIPE, text=True)
strings = None
for line in proc.stdout:
    if "member=Notify" in line:
        strings = []
        continue
    if strings is None:
        continue
    m = STR.match(line)
    if m:
        strings.append(m.group(1))
    if len(strings) == 4:  # app_name, app_icon, summary, body
        app, _, summary, body = strings
        strings = None
        print(f"[{app}] {summary} | {body}", file=sys.stderr, flush=True)
        if app.lower() in APPS and PATTERN.search(f"{summary} {body}"):
            due.alert(summary, body)
