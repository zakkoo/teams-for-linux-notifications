#!/usr/bin/env python3
"""Poll an IMAP mailbox for forwarded meeting invites (.ics attachments); alert before each occurrence."""
import email, imaplib, os, sys, time
sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "..", "alert"))
import due, ics

due.load_env()
HOST, USER, PASS = (os.environ.get(k) or sys.exit(f"set {k} in config.env") for k in ("IMAP_HOST", "IMAP_USER", "IMAP_PASS"))
FOLDER = os.environ.get("IMAP_FOLDER", "INBOX")
texts = {}  # message uid -> ics text


def fetch_new():
    m = imaplib.IMAP4_SSL(HOST)
    m.login(USER, PASS)
    m.select(FOLDER, readonly=True)
    _, data = m.uid("search", None, "SINCE", time.strftime("%d-%b-%Y", time.gmtime(time.time() - 14 * 86400)))
    for uid in data[0].split():
        if uid in texts:
            continue
        _, msg = m.uid("fetch", uid, "(RFC822)")
        for part in email.message_from_bytes(msg[0][1]).walk():
            if part.get_content_type() == "text/calendar" or (part.get_filename() or "").endswith(".ics"):
                texts[uid] = part.get_payload(decode=True).decode("utf-8", "replace")
    m.logout()


events, last = [], 0
while True:
    if time.time() - last > 120:
        try:
            fetch_new()
            events = [o for t in texts.values() for o in ics.parse(t)]
            print(f"{len(texts)} invites, {len(events)} occurrences", file=sys.stderr, flush=True)
        except Exception as e:
            print(f"imap failed: {e}", file=sys.stderr, flush=True)
        last = time.time()
    due.alert_due(events)
    time.sleep(30)
