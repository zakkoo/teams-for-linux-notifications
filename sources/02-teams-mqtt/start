#!/usr/bin/env python3
"""Stdlib-only MQTT broker (3.1.1 + 5, QoS 0/1) just for teams-for-linux.
Reacts to <prefix>/meeting-started and asks for <prefix>/calendar every 5 min."""
import json, os, socket, sys, threading, time
from datetime import datetime, timedelta, timezone
sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "..", "alert"))
import due

PREFIX = os.environ.get("MQTT_PREFIX", "teams")
STATE = os.environ.get("MEETING_ALERT_STATE_DIR") or os.path.expanduser("~/.local/state")
events = []  # last calendar seen
client = None


def log(msg):
    line = f"{time.strftime('%F %T')} {msg}"
    print(line, file=sys.stderr, flush=True)
    with open(f"{STATE}/meeting-alert-02.log", "a") as f:
        f.write(line + "\n")


def varint(n):
    out = b""
    while True:
        b, n = n % 128, n // 128
        out += bytes([b | 0x80]) if n else bytes([b])
        if not n:
            return out


def rdvar(buf, i):
    n, mult = 0, 1
    while True:
        n += (buf[i] & 127) * mult; mult *= 128; i += 1
        if not buf[i - 1] & 128:
            return n, i


def mkstr(s):
    b = s.encode(); return len(b).to_bytes(2, "big") + b


def rdstr(buf, i):
    n = int.from_bytes(buf[i:i + 2], "big"); return buf[i + 2:i + 2 + n].decode(), i + 2 + n


def read_exact(sock, n):
    buf = b""
    while len(buf) < n:
        chunk = sock.recv(n - len(buf))
        if not chunk:
            return None
        buf += chunk
    return buf


def read_packet(sock):
    h = read_exact(sock, 1)
    if not h:
        return None
    rem, mult = 0, 1
    while True:
        b = read_exact(sock, 1)
        if b is None:
            return None
        rem += (b[0] & 127) * mult; mult *= 128
        if not b[0] & 128:
            break
    return h[0] >> 4, h[0] & 15, (read_exact(sock, rem) if rem else b"")


class Client:
    def __init__(self, sock):
        self.sock, self.v5, self.subs, self.lock = sock, False, set(), threading.Lock()

    def send(self, type_flags, body):
        with self.lock:
            self.sock.sendall(bytes([type_flags]) + varint(len(body)) + body)

    def publish(self, topic, payload):
        self.send(0x30, mkstr(topic) + (b"\x00" if self.v5 else b"") + payload)

    def serve(self):
        while (pk := read_packet(self.sock)) is not None:
            t, fl, body = pk
            if t == 1:  # CONNECT
                _, i = rdstr(body, 0)
                self.v5 = body[i] >= 5
                i += 4  # level, flags, keepalive
                if self.v5:
                    n, i = rdvar(body, i); i += n
                cid, _ = rdstr(body, i)
                log(f"connected: {cid} (mqtt{'5' if self.v5 else '3.1.1'})")
                self.send(0x20, b"\x00\x00\x00" if self.v5 else b"\x00\x00")
            elif t == 8:  # SUBSCRIBE
                pid, i = body[:2], 2
                if self.v5:
                    n, i = rdvar(body, i); i += n
                codes = b""
                while i < len(body):
                    topic, i = rdstr(body, i); i += 1
                    self.subs.add(topic); codes += b"\x00"
                log(f"subscribed: {sorted(self.subs)}")
                self.send(0x90, pid + (b"\x00" if self.v5 else b"") + codes)
                for topic in self.subs:  # teams-for-linux 2.20 publishes under "undefined/" unless topicPrefix is set; follow whatever it uses
                    if topic.endswith("/command"):
                        global PREFIX
                        PREFIX = topic[:-len("/command")]
                request_calendar()
            elif t == 3:  # PUBLISH
                qos = (fl >> 1) & 3
                topic, i = rdstr(body, 0)
                if qos:
                    self.send(0x40, body[i:i + 2]); i += 2
                if self.v5:
                    n, i = rdvar(body, i); i += n
                on_message(topic, body[i:])
            elif t == 12:  # PINGREQ
                self.send(0xD0, b"")
            elif t == 14:  # DISCONNECT
                break


def on_message(topic, payload):
    global events
    text = payload.decode(errors="replace")
    log(f"{topic}: {text[:120]}")
    if topic == f"{PREFIX}/meeting-started" and text == "true":
        due.alert("Meeting started", "Teams says a meeting you're invited to just started")
    elif topic == f"{PREFIX}/calendar":
        open(f"{STATE}/meeting-alert-02-last-calendar.json", "w").write(text)
        try:
            events = due.parse_graph_events(json.loads(text))
            log(f"parsed {len(events)} events: " + "; ".join(f"{s.astimezone():%H:%M} {subj}" for _, s, subj, _ in events))
            due.alert_due(events)
        except ValueError as e:
            log(f"bad calendar payload: {e}")


def request_calendar():
    if client and f"{PREFIX}/command" in client.subs:
        s = datetime.now(timezone.utc).replace(hour=0, minute=0, second=0, microsecond=0)
        cmd = {"action": "get-calendar", "startDate": s.isoformat(), "endDate": (s + timedelta(days=1)).isoformat()}
        client.publish(f"{PREFIX}/command", json.dumps(cmd).encode())
        log(f"sent {cmd}")


def ticker():
    n = 0
    while True:
        time.sleep(30); n += 1
        due.alert_due(events)
        if n % 10 == 0:
            request_calendar()


def main():
    global client
    due.load_env()
    os.makedirs(STATE, exist_ok=True)
    srv = socket.create_server(("127.0.0.1", int(os.environ.get("MQTT_PORT", 1883))))
    threading.Thread(target=ticker, daemon=True).start()
    while True:
        sock, _ = srv.accept()
        client = Client(sock)
        try:
            client.serve()
        except OSError as e:
            log(f"client dropped: {e}")
        finally:
            sock.close()


if __name__ == "__main__":
    main()
