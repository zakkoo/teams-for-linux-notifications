#!/usr/bin/env python3
"""Borrow the Graph token from the running Teams for Linux via Chrome DevTools Protocol, poll calendarView."""
import base64, json, os, socket, struct, sys, time, urllib.parse, urllib.request
sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "..", "alert"))
import due

TOKEN_JS = """(async () => {
  const h = window.teamsForLinuxReactHandler;
  if (!h || typeof h.acquireToken !== 'function') return {success:false, error:'no reactHandler (enable graphApi in config)'};
  return await h.acquireToken('https://graph.microsoft.com');
})()"""


def ws_connect(url):
    u = urllib.parse.urlparse(url)
    s = socket.create_connection((u.hostname, u.port))
    key = base64.b64encode(os.urandom(16)).decode()
    s.sendall((f"GET {u.path} HTTP/1.1\r\nHost: {u.hostname}:{u.port}\r\nUpgrade: websocket\r\n"
               f"Connection: Upgrade\r\nSec-WebSocket-Key: {key}\r\nSec-WebSocket-Version: 13\r\n\r\n").encode())
    hdr = b""
    while b"\r\n\r\n" not in hdr:
        hdr += s.recv(1)
    if b" 101 " not in hdr.split(b"\r\n")[0]:
        raise OSError(f"websocket handshake failed: {hdr[:80]!r}")
    return s


def ws_send(s, text):
    data = text.encode()
    n = len(data)
    head = bytes([0x81]) + (bytes([0x80 | n]) if n < 126 else bytes([0x80 | 126]) + struct.pack(">H", n) if n < 65536 else bytes([0x80 | 127]) + struct.pack(">Q", n))
    mask = os.urandom(4)
    s.sendall(head + mask + bytes(b ^ mask[i % 4] for i, b in enumerate(data)))


def _recv(s, n):
    buf = b""
    while len(buf) < n:
        chunk = s.recv(n - len(buf))
        if not chunk:
            raise OSError("websocket closed")
        buf += chunk
    return buf


def ws_recv(s):
    b1, b2 = _recv(s, 2)
    n = b2 & 127
    if n == 126:
        n = struct.unpack(">H", _recv(s, 2))[0]
    elif n == 127:
        n = struct.unpack(">Q", _recv(s, 8))[0]
    return _recv(s, n).decode(errors="replace")  # ponytail: assumes single unmasked text frames, which CDP sends


def graph_token(port):
    pages = json.load(urllib.request.urlopen(f"http://127.0.0.1:{port}/json", timeout=5))
    page = next((p for p in pages if p.get("type") == "page" and "teams.microsoft.com" in p.get("url", "")), None)
    if not page:
        raise OSError("no Teams page in CDP target list")
    s = ws_connect(page["webSocketDebuggerUrl"])
    ws_send(s, json.dumps({"id": 1, "method": "Runtime.evaluate",
                           "params": {"expression": TOKEN_JS, "awaitPromise": True, "returnByValue": True}}))
    while True:
        msg = json.loads(ws_recv(s))
        if msg.get("id") == 1:
            s.close()
            r = msg.get("result", {}).get("result", {}).get("value") or {}
            if not r.get("success"):
                raise OSError(f"token: {r.get('error') or msg}")
            return r["token"]


def calendar(token):
    s = time.strftime("%Y-%m-%dT00:00:00Z", time.gmtime())
    e = time.strftime("%Y-%m-%dT00:00:00Z", time.gmtime(time.time() + 86400))
    url = ("https://graph.microsoft.com/v1.0/me/calendarView?" + urllib.parse.urlencode({
        "startDateTime": s, "endDateTime": e, "$top": 50,
        "$select": "id,subject,start,isCancelled,isAllDay,onlineMeeting,webLink"}))
    req = urllib.request.Request(url, headers={"Authorization": f"Bearer {token}", "Prefer": 'outlook.timezone="UTC"'})
    return due.parse_graph_events(json.load(urllib.request.urlopen(req, timeout=20)))


def main():
    due.load_env()
    port = int(os.environ.get("CDP_PORT", 9222))
    events, last = [], 0
    while True:
        if time.time() - last > 300:
            try:
                events = calendar(graph_token(port)); last = time.time()
                print(f"{len(events)} events today", file=sys.stderr, flush=True)
            except Exception as e:
                print(f"fetch failed: {e}", file=sys.stderr, flush=True)
                last = time.time() - 240  # retry in 1 min
        due.alert_due(events)
        time.sleep(30)


if __name__ == "__main__":
    main()
