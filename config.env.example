# cp config.env.example config.env ; edit. Sourced by every source and by the systemd unit.
LEAD_MINUTES=2

# 01-dbus-sniff
DBUS_APPS="Microsoft Teams,teams-for-linux,Firefox"
DBUS_PATTERN="(?i)\b(start(ed|ing|s)?|now|minutes?|reminder|join)\b"

# 02-teams-mqtt
MQTT_PORT=1883
MQTT_PREFIX=teams

# 03-teams-cdp
CDP_PORT=9222

# 04-hypr-events
HYPR_CLASS=teams-for-linux
HYPR_TITLE_PATTERN="(?i)meeting (has )?start|is starting|join now"

# 06-power-automate
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=

# 07-ics-feed
ICS_URL=

# 08-email-rule
IMAP_HOST=
IMAP_USER=
IMAP_PASS=
IMAP_FOLDER=INBOX
